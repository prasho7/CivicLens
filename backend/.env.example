# CivicLens Backend Configuration (.env)

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS - Allowed Frontend Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Supabase PostgreSQL Configuration
# Obtain these from your Supabase Project Settings -> API / Database
SUPABASE_URL=https://your-project-id.supabase.co
# Use your project anon public key or service role key
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Direct PostgreSQL Connection String (Optional for direct migrations)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# AI Intelligence Configuration (Optional)
# If provided, CivicLens utilizes Google Gemini for report understanding.
# If omitted, CivicLens automatically engages the Rule-Based Intake Engine (Heuristic Fallback).
GEMINI_API_KEY=your-gemini-api-key-here
DUPLICATE_THRESHOLD=0.60
